PORT=3000
NODE_ENV=development
JWT_SECRET=troca_esta_chave_em_producao_com_mais_de_32_caracteres
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=http://localhost:3000
API_RATE_WINDOW_MS=900000
API_RATE_MAX=500
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20
# Supabase > Connect > Session pooler.
# Exemplo do formato real; substitui os tres valores em maiusculas.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_CONNECTION_LIMIT=10

# Usado apenas se a tabela funcionarios ainda estiver vazia.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=troca-esta-password

# Supabase > Project Settings > API. A service role e exclusiva do backend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=documents
